					float3 hsvTorgb33 = RGBToHSV( SAMPLE_TEXTURE2D( _DiffuseMap, sampler_Linear_Repeat, uv_DiffuseMap ).rgb );
					float3 hsvTorgb36 = HSVToRGB( float3(hsvTorgb33.x,( _TongueSaturation * hsvTorgb33.y ),( hsvTorgb33.z * _TongueBrightness )) );
					float2 uv_GradientAOMap = IN.ase_texcoord6.xy * _GradientAOMap_ST.xy + _GradientAOMap_ST.zw;
					float4 tex2DNode31 = SAMPLE_TEXTURE2D( _GradientAOMap, sampler_Linear_Repeat, uv_GradientAOMap );
					float3 lerpResult40 = lerp( ( _RearAO * hsvTorgb36 ) , ( hsvTorgb36 * _FrontAO ) , tex2DNode31.b);
					float3 baseColor101 = lerpResult40;
					
					float2 uv_NormalMap = IN.ase_texcoord6.xy * _NormalMap_ST.xy + _NormalMap_ST.zw;
					float2 temp_cast_1 = (_MicroNormalTiling).xx;
					float2 texCoord77 = IN.ase_texcoord6.xy * temp_cast_1 + float2( 0,0 );
					
					float2 uv_MaskMap = IN.ase_texcoord6.xy * _MaskMap_ST.xy + _MaskMap_ST.zw;
					float4 tex2DNode52 = SAMPLE_TEXTURE2D( _MaskMap, sampler_Linear_Repeat, uv_MaskMap );
					float lerpResult58 = lerp( _SmoothnessFront , _SmoothnessMax , tex2DNode52.a);
					float lerpResult60 = lerp( _SmoothnessRear , lerpResult58 , tex2DNode31.b);
